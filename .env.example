# Copy to .env and fill in. Never commit .env.

# GitHub token used by both Renovate and the watcher.
# Classic PAT with scopes: repo, workflow
# (a fine-grained token works too if all watched repos share one owner;
#  it needs Contents, Issues, Pull requests and Workflows read/write.)
GITHUB_TOKEN=

# Claude Code authentication for AI fixes - set ONE of these:
#  - API key from console.anthropic.com
ANTHROPIC_API_KEY=
#  - or a subscription token: run `claude setup-token` and paste the result
CLAUDE_CODE_OAUTH_TOKEN=

# Notifications (optional) - set either, both or none
#  Slack: create an Incoming Webhook (api.slack.com/messaging/webhooks)
SLACK_WEBHOOK_URL=
#  Telegram: create a bot with @BotFather, send it a message, then get your chat id
#  from https://api.telegram.org/bot<TOKEN>/getUpdates (groups have negative ids)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Which events to send (comma-separated, or "all"):
#  new_findings, reopened, resolved, ai_pr, ai_failed, renovate_security, errors, self_update
# Default: everything except "resolved"
# NOTIFY_EVENTS=

# Optional
# CLAUDE_MODEL=
# AI_LANGUAGE=English          # default language of AI-written PR descriptions (per repo: "ai_language")
# SEMGREP_CONFIGS=p/default
# Registry login for scanning private images with Trivy (e.g. GHCR: your username + GITHUB_TOKEN)
# TRIVY_USERNAME=
# TRIVY_PASSWORD=
GIT_AUTHOR_NAME=security-watch
GIT_AUTHOR_EMAIL=security-watch@users.noreply.github.com
RENOVATE_TIMEZONE=UTC
SCAN_INTERVAL_HOURS=24
LOOP_MINUTES=15
RENOVATE_INTERVAL_SECONDS=3600
